{
  "name": "@kopaka/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/workspace.mjs build @kopaka/api",
    "compile": "node ../../scripts/db.mjs generate && tsc -p tsconfig.json",
    "dev": "node ../../scripts/workspace.mjs dev @kopaka/api",
    "start": "node dist/main.js",
    "typecheck": "node ../../scripts/db.mjs generate && tsc -p tsconfig.json --noEmit",
    "test:compile": "node ../../scripts/workspace.mjs build @kopaka/api && tsc -p tsconfig.test.json",
    "test:unit": "pnpm test:compile && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config test/jest.config.mjs --runInBand",
    "test:integration": "node ../../scripts/integration.mjs"
  },
  "dependencies": {
    "@nestjs/core": "12.3.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "zod": "4.6.7",
    "dotenv": "18.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@kopaka/shared-types": "workspace:*",
    "@kopaka/validation": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2"
  }
}
